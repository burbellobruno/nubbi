# Chat: cualquier API compatible con OpenAI.
# Groq (nube, recomendado para local y Render):
CHAT_BASE_URL=https://api.groq.com/openai/v1
CHAT_API_KEY=tu_clave_groq
CHAT_MODEL=openai/gpt-oss-120b
CHAT_MODEL_ALLOWLIST=openai/gpt-oss-20b,openai/gpt-oss-120b

# Ollama local (solo si lo tenés instalado y corriendo):
# CHAT_BASE_URL=http://localhost:11434/v1
# CHAT_API_KEY=ollama
# CHAT_MODEL=qwen2.5:7b

# Proveedor alternativo solo para el modo adulto (opcional).
# Cualquier API compatible con OpenAI cuyos términos permitan ficción adulta legal.
# Si no está configurado, el modo adulto usa el proveedor general.
# ADULT_CHAT_BASE_URL=https://tu-proveedor/v1
# ADULT_CHAT_API_KEY=tu_clave
# ADULT_CHAT_MODEL=tu-modelo

# Imágenes: elegí un proveedor.
#
# 1) Cloudflare Workers AI (GRATIS, sin GPU ni tarjeta; recomendado para retratos).
#    Plan free: 10.000 neuronas/día (~100-170 imágenes). No genera imágenes explícitas.
#    Creá el token en Cloudflare Dashboard -> Workers AI -> Use REST API.
#    El token necesita permisos Workers AI - Read y Workers AI - Edit.
# CF_ACCOUNT_ID=tu_account_id_de_32_caracteres
# CF_API_TOKEN=tu_token_de_workers_ai
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CF_IMAGE_STEPS=4
# CF_TIMEOUT_MS=60000
#
# 2) Forge/A1111 con --api (local o GPU cloud; permite más control y contenido adulto).
#    En local podés usar localhost; en Render usá la URL pública completa del GPU
#    (https://...), no un ID interno de Render.
#    Este backend usa la API A1111 de Forge. ComfyUI requiere un adaptador.
# SD_URL=http://127.0.0.1:7860
#
# Si Cloudflare está configurado, se usa automáticamente. Para forzar uno:
# IMAGE_PROVIDER=cloudflare
# IMAGE_PROVIDER=forge
# IMAGE_PROVIDER=huggingface
# HuggingFace: el modelo debe estar disponible en el proveedor hf-inference.
# HF_TOKEN=tu_token_de_huggingface
# HF_IMAGE_MODEL=cagliostrolab/animagine-xl-3.1
# HF_TIMEOUT_MS=120000

# Firebase: clave API del mismo proyecto configurado en public/firebase-config.js.
# Obligatoria en el servidor para verificar las sesiones al generar imágenes.
# FIREBASE_API_KEY=tu_clave_api_de_firebase
# Cuota por usuario, reinicio diario a las 00:00 UTC (Map en memoria).
# IMAGE_DAILY_LIMIT=5

# Autenticación del endpoint de Forge. Acepta:
#   Basic usuario:clave  |  Bearer token  |  solo token
# SD_AUTH=Basic usuario:clave
# SD_TIMEOUT_MS=120000

# Prompt negativo base de Forge. No quites las protecciones de menores.
# SD_NEGATIVE=child, minor, underage, teen, loli, shota, kid, lowres, bad anatomy

# Mapa opcional de checkpoints de Forge. JSON con las mismas claves que el selector.
# SD_CHECKPOINTS={"counterfeit":"Counterfeit-V3.0_fp16","anything":"anything-v5"}

# Puerto local. En Render NO definas PORT: lo asigna Render automáticamente.
PORT=3001
