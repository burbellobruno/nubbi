# Chat: cualquier API compatible con OpenAI.
# Groq (nube, recomendado para local y Render):
CHAT_BASE_URL=https://api.groq.com/openai/v1
CHAT_API_KEY=tu_clave_groq
CHAT_MODEL=openai/gpt-oss-20b

# Ollama local (solo si lo tenés instalado y corriendo):
# CHAT_BASE_URL=http://localhost:11434/v1
# CHAT_API_KEY=ollama
# CHAT_MODEL=qwen2.5:7b

# Proveedor alternativo solo para el modo adulto (opcional).
# Cualquier API compatible con OpenAI cuyos términos permitan ficción adulta legal.
# Si no está configurado, el modo adulto usa el proveedor general.
# ADULT_CHAT_BASE_URL=https://tu-proveedor/v1
# ADULT_CHAT_API_KEY=tu_clave
# ADULT_CHAT_MODEL=tu-modelo

# Imágenes: Forge/A1111 con --api (local o GPU cloud).
# En local podés usar localhost; en Render usá la URL pública completa del GPU
# (https://...), no un ID interno de Render.
# Este backend usa la API A1111 de Forge. ComfyUI requiere un adaptador.
SD_URL=http://127.0.0.1:7860

# Autenticación del endpoint de imágenes. Acepta:
#   Basic usuario:clave  |  Bearer token  |  solo token
# SD_AUTH=Basic usuario:clave
# SD_TIMEOUT_MS=120000

# Prompt negativo base. No quites las protecciones de menores.
# SD_NEGATIVE=child, minor, underage, teen, loli, shota, kid, lowres, bad anatomy

# Mapa opcional de checkpoints. JSON con las mismas claves que el selector de la app.
# SD_CHECKPOINTS={"counterfeit":"Counterfeit-V3.0_fp16","anything":"anything-v5"}

# Puerto local. En Render NO definas PORT: lo asigna Render automáticamente.
PORT=3001
